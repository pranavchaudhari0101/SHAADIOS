# ============================================
# NEON DATABASE CONFIGURATION
# ============================================
# Get these from your Neon dashboard: https://console.neon.tech
# DATABASE_URL - For serverless connections (HTTP)
# DIRECT_URL - For migrations (TCP connection)

DATABASE_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/shaadios?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/shaadios?sslmode=require"

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# ============================================
# THIRD-PARTY SERVICES
# ============================================

# WhatsApp Business API (Twilio)
TWILIO_ACCOUNT_SID="ACxxx"
TWILIO_AUTH_TOKEN="xxx"
TWILIO_PHONE_NUMBER="+14155238886"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Payment Gateway (Razorpay - India)
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"
RAZORPAY_WEBHOOK_SECRET="xxx"

# Email Service (Resend)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="ShaadiOS <noreply@shaadios.com>"

# File Storage (AWS S3 or Cloudflare R2)
AWS_ACCESS_KEY_ID="AKIAxxx"
AWS_SECRET_ACCESS_KEY="xxx"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="shaadios-uploads"

# ============================================
# REDIS (Optional - for caching & sessions)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# APPLICATION
# ============================================
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3001"

# ============================================
# SECURITY
# ============================================
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
