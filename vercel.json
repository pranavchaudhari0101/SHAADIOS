{
  "version": 2,
  "buildCommand": "cd backend && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://shaadios-backend.vercel.app/api/$1"
    }
  ]
}
